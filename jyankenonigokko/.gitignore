# ==========================================
# Unity Standard Ignores
# ==========================================
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log

# Subfolder specific temporary directories (プロジェクトがサブフォルダにある場合用)
**/Library/
**/Temp/
**/Obj/
**/Build/
**/Builds/
**/Logs/
**/UserSettings/

# ==========================================
# Large Files & Compressed Archives (100MBオーバー防止)
# ==========================================
*.zip
*.tar.gz
*.7z
*.rar
*.psd
*.blend

# ==========================================
# Blender & 3D Tools
# ==========================================
*.blend1
*.blend1.meta

# ==========================================
# Sensitive & Heavy Data
# ==========================================
/[Mm]emoryCaptures/
/[Rr]ecordings/

# ==========================================
# IDE & System Cache
# ==========================================
.vs/
.gradle/
.idea/
.DS_Store
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity generated meta files for deleted/build files
*.pidb.meta
*.pdb.meta
*.mdb.meta
sysinfo.txt
mono_crash.*

# Builds Output
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics & Tests
crashlytics-build.properties
InitTestScene*.unity*

# Addressables
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting & Cache
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*
/[Aa]ssets/[Ss]ceneDependencyCache*